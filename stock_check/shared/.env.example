# stock_check 환경변수 예시 파일.
# 실제 사용 파일: stock_check/shared/.env (이 파일은 .gitignore 처리되어 커밋되지 않음)
#
# 사용:
#   1) 이 파일을 같은 폴더에 .env 로 복사  ( cp .env.example .env )
#   2) 아래 값을 본인 값으로 채운다
#   3) stock_check 모듈/스크립트가 자동 로드한다 (python-dotenv)

# ───────────────────────────────────────────────
# 더현대Hi 로그인 자격증명 (옵션, --login 캡쳐/스크래핑용)
# ───────────────────────────────────────────────
HYUNDAI_LOGIN_ID=
HYUNDAI_LOGIN_PW=

# ───────────────────────────────────────────────
# Chrome 동작
# ───────────────────────────────────────────────
# new(기본) | old | off  (off 면 실제 창을 띄움)
# CHROME_HEADLESS_MODE=off
# CHROME_DRIVER_PATH=/usr/local/bin/chromedriver
# CHROME_UA=Mozilla/5.0 ...

# ───────────────────────────────────────────────
# 이메일/텔레그램 알림 (운영 환경에서 사용)
# ───────────────────────────────────────────────
# SMTP_SERVER=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_RECIPIENTS=

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
#
# ── 소스별 전용 텔레그램 봇 (2026-08-29 분리) ────────────────────────────
# 위 TELEGRAM_BOT_TOKEN = 컬티즘 봇 + 103 시스템/헬스 알림 공용.
# 더현대 catalog-watch 는 아래 전용 토큰을 우선 사용(없으면 위 TELEGRAM_BOT_TOKEN 폴백):
# HCW_TELEGRAM_BOT_TOKEN=
# HCW_TELEGRAM_CHAT_ID=
#
# 헬스/시스템 알림(health_monitor.py)은 브릿지봇(rrl_stock_bot)으로, '문제 있을 때만':
# HEALTH_TELEGRAM_BOT_TOKEN=       # 없으면 TELEGRAM_BOT_TOKEN(컬티즘) 폴백
# HEALTH_TELEGRAM_CHAT_ID=         # 없으면 TELEGRAM_CHAT_ID
# (mode_daily 는 서비스 down/자원임계 초과 등 문제 감지 시에만 발송; 정상이면 무발송)            # 보통 TELEGRAM_CHAT_ID 와 동일(유저 계정 고유값)
# (리바이스/네이버 봇은 Mac mini 의 hd-rrl/config/local.json 의
#  levi_telegram_bot_token / naver_telegram_bot_token 키 — 이 레포 밖)
#
# 더현대 로그인(사이즈 Drawer 판독에 필요):
# HYUNDAI_LOGIN_ID=
# HYUNDAI_LOGIN_PW=
# HYUNDAI_DEBUG_DUMP=1            # 0 이면 판독 실패 덤프 안 남김(디스크 절약)

# 재고 알림 정책 기본값:
# - ACK 링크는 기본 비활성화
# - 재입고 이벤트 1회당 텔레그램은 10초 간격 3회 연속 발송
# - 같은 재고 이벤트는 이메일/텔레그램 모두 24시간 중복 억제
STOCK_CHECK_ACK_ENABLED=false
EMAIL_ALERT_INTERVAL=86400
TELEGRAM_ALERT_INTERVAL=86400
TELEGRAM_REPEAT_COUNT=3
TELEGRAM_INTERVAL=10
