# stock_check 환경변수 예시 파일.
# 실제 사용 파일: stock_check/shared/.env (이 파일은 .gitignore 처리되어 커밋되지 않음)
#
# 사용:
#   1) 이 파일을 같은 폴더에 .env 로 복사  ( cp .env.example .env )
#   2) 아래 값을 본인 값으로 채운다
#   3) stock_check 모듈/스크립트가 자동 로드한다 (python-dotenv)

# ───────────────────────────────────────────────
# 더현대Hi 로그인 자격증명 (옵션, --login 캡쳐/스크래핑용)
# ───────────────────────────────────────────────
HYUNDAI_LOGIN_ID=
HYUNDAI_LOGIN_PW=

# ───────────────────────────────────────────────
# Chrome 동작
# ───────────────────────────────────────────────
# new(기본) | old | off  (off 면 실제 창을 띄움)
# CHROME_HEADLESS_MODE=off
# CHROME_DRIVER_PATH=/usr/local/bin/chromedriver
# CHROME_UA=Mozilla/5.0 ...

# ───────────────────────────────────────────────
# 이메일/텔레그램 알림 (운영 환경에서 사용)
# ───────────────────────────────────────────────
# SMTP_SERVER=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_RECIPIENTS=

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# 재고 알림 정책 기본값:
# - ACK 링크는 기본 비활성화
# - 재입고 이벤트 1회당 텔레그램은 10초 간격 3회 연속 발송
# - 같은 재고 이벤트는 이메일/텔레그램 모두 24시간 중복 억제
STOCK_CHECK_ACK_ENABLED=false
EMAIL_ALERT_INTERVAL=86400
TELEGRAM_ALERT_INTERVAL=86400
TELEGRAM_REPEAT_COUNT=3
TELEGRAM_INTERVAL=10
